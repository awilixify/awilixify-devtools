{
	"name": "@awilixify/devtools",
	"version": "0.2.2",
	"packageManager": "pnpm@10.34.4",
	"description": "Developer tools for inspecting Awilixify module graphs, routes, traces, and provider impact.",
	"keywords": [
		"awilixify",
		"awilix",
		"devtools",
		"dependency-injection",
		"di",
		"module-graph",
		"provider-impact",
		"tracing"
	],
	"homepage": "https://github.com/awilixify/awilixify-devtools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/awilixify/awilixify-devtools.git"
	},
	"type": "module",
	"main": "./dist/devtools.module.js",
	"types": "./dist/devtools.module.d.ts",
	"exports": {
		".": {
			"types": "./dist/devtools.module.d.ts",
			"import": "./dist/devtools.module.js"
		}
	},
	"files": [
		"README.md",
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"clean": "del-cli dist",
		"lint": "biome check src",
		"lint:fix": "biome check --write src"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^6.0.0",
		"@sinclair/typebox": "^0.34.49",
		"fastify": "^5.2.0",
		"ts-morph": "^28.0.0"
	},
	"peerDependencies": {
		"awilix": ">=9.0.0",
		"awilixify": ">=3.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@types/node": "^22.15.21",
		"awilixify": "^3.1.3",
		"del-cli": "^7.0.0",
		"typescript": "^5.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
