{
	"name": "awilixify-devtools",
	"version": "0.1.0",
	"packageManager": "pnpm@10.34.4",
	"description": "Developer tools for inspecting Awilixify module graphs, routes, traces, and provider impact.",
	"keywords": [
		"awilixify",
		"awilix",
		"devtools",
		"dependency-injection",
		"di",
		"module-graph",
		"provider-impact",
		"tracing"
	],
	"homepage": "https://github.com/wildstyles/awilixify-devtools",
	"repository": {
		"type": "git",
		"url": "git://github.com/wildstyles/awilixify-devtools.git"
	},
	"type": "module",
	"main": "./dist/devtools/devtools.module.js",
	"types": "./dist/devtools/devtools.module.d.ts",
	"exports": {
		".": {
			"types": "./dist/devtools/devtools.module.d.ts",
			"import": "./dist/devtools/devtools.module.js"
		}
	},
	"files": [
		"README.md",
		"dist/devtools"
	],
	"scripts": {
		"build": "npm run build:devtools && npm run build:ui",
		"build:devtools": "tsc -p tsconfig.devtools.json",
		"build:ui": "pnpm --filter @awilixify-devtools/ui build",
		"build:devtools:watch": "tsc -p tsconfig.devtools.json --watch --preserveWatchOutput",
		"build:ui:watch": "pnpm --filter @awilixify-devtools/ui build:watch",
		"build:watch": "npm run build:devtools:watch & npm run build:ui:watch & wait",
		"build:release": "del-cli dist/devtools && npm run lint && npm run build:devtools",
		"check-types": "tsc -b",
		"dev": "pnpm --filter @awilixify-devtools/ui dev",
		"lint": "biome check devtools devtools-ui/src devtools-ui/vite.config.ts devtools-ui/orval.config.ts",
		"lint:fix": "biome check --write devtools devtools-ui/src devtools-ui/vite.config.ts devtools-ui/orval.config.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^6.0.0",
		"@sinclair/typebox": "^0.34.49",
		"fastify": "^5.2.0",
		"ts-morph": "^28.0.0"
	},
	"peerDependencies": {
		"awilix": ">=9.0.0",
		"awilixify": ">=3.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@types/node": "^22.15.21",
		"awilixify": "^3.1.2",
		"del-cli": "^7.0.0",
		"typescript": "^5.8.0"
	}
}
